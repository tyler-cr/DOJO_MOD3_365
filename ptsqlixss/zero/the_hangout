@app.route("/login", methods=["POST"])
def challenge_login():
    identification = flask.request.form.get("identification")
    bot_key = flask.request.form.get("bot_key", "")

    if not identification:
        flask.abort(400, "Missing `identification` form parameter")

    if identification == EVIL_USER:
        try:
            with open("/challenge/bot_key") as f:
                real_key = f.read().strip()
        except FileNotFoundError:
            flask.abort(403, "You aren't allowed in!")

        if bot_key != real_key:
            flask.abort(403, "You aren't allowed in!")

        flask.session["identification"] = identification
        return flask.redirect("/")

    user = db.execute(
        "SELECT * FROM patrons WHERE patron = ? AND canlogin = TRUE",
        (identification,)
    ).fetchone()

    if not user:
        flask.abort(403, "You aren't allowed in!")

    flask.session["identification"] = identification
    return flask.redirect("/")

