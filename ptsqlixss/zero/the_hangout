@app.route("/make_table_public", methods=["POST"])
def make_table_public():
    if "identification" not in flask.session:
        flask.abort(403, "Patron must be allowed in by doorman first!")

    row = db.execute(
        "SELECT table_name FROM patrons WHERE patron = ?",
        (flask.session["identification"],)
    ).fetchone()

    if not row:
        flask.abort(404)

    db.execute(
        "UPDATE tables SET public = TRUE WHERE table_name = ?",
        (row["table_name"],)
    )

    return flask.redirect("/")

