@app.route("/change_keepsake", methods=["GET", "POST"])
def change_keepsake():
    if "identification" not in flask.session:
        flask.abort(403, "Patron must be allowed in by doorman first!")

    page = """
            <form action="/change_keepsake" method="post">
              <textarea name=leader>Insert Leader ID!</textarea>
              <textarea name=table>Insert Table ID!</textarea>
              <textarea name=curkeep>Insert Current Keepsake!</textarea>
              <textarea name=newkeep>Insert New Keepsake!</textarea>
              <input type=submit value=Save>Change!
            </form><br><a href=publish>Publish your drafts!</a><hr>
        """

    if flask.request.method == "POST":
        leader = flask.request.form.get("leader", "")
        table = flask.request.form.get("table", "")
        curkeep = flask.request.form.get("curkeep", "")
        newkeep = flask.request.form.get("newkeep", "")

        # NOTE: IF YOU ARE NOT CAREFUL HERE, YOU WILL HAVE TO REDO THE CHALLENGE!
        try:
            update_result = db.execute(
                f"UPDATE tables SET keepsake = ? "
                f"WHERE keepsake = {curkeep} "
                f"AND table_name = ? "
                f"AND leader = ?",
                (newkeep, table, leader)
            )
        except sqlite3.Error as e:
            return page + f"<p>The keepsake shot first! {e}</p>"

        if update_result.rowcount <= 0:
            return page + "<p>No matching table found!</p>"

        result = db.execute(
            "SELECT keepsake FROM tables WHERE table_name = ? AND leader = ?",
            (table, leader)
        ).fetchone()

        if not result:
            return page + "<p>No matching table found!</p>"

        return page + f"<p>Your new keepsake is: {result['keepsake']}</p>"

    return page

