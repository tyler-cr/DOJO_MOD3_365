EVIL_USER_FILE = "/challenge/evil_user"

def get_or_create_evil_user():
    try:
        with open(EVIL_USER_FILE, "r") as f:
            evil_user = f.read().strip()
            if evil_user:
                return evil_user
    except FileNotFoundError:
        pass

    evil_user = ''.join(random.choices(string.ascii_lowercase, k=8))

    with open(EVIL_USER_FILE, "w") as f:
        f.write(evil_user)
        os.chmod(EVIL_USER_FILE, 0o400)
    return evil_user

EVIL_USER = get_or_create_evil_user()
