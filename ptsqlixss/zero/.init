#!/usr/local/bin/python

import os
import random
import string

file_name = ''.join(random.choices(string.ascii_lowercase, k=8))

evil_user = ''.join(random.choices(string.ascii_lowercase, k=8))

os.makedirs("/challenge/tables", exist_ok=True)

with open(f"/challenge/{file_name}", "w") as file:
    file.write(f"all your flag are belong to us... -- {evil_user}")

os.chmod(f"/challenge/{file_name}", 0o400)

os.remove(__file__)