#!/usr/local/bin/python

import os
import random
import string

file_name = ''.join(random.choices(string.ascii_lowercase, k=8))

os.makedirs("/challenge/tables", exist_ok=True)

with open(f"/challenge/tables/{file_name}", "w") as file:
    file.write("all your base are belong to us... --cats")

os.chmod(f"/challenge/tables/{file_name}", 0o400)

os.remove(__file__)