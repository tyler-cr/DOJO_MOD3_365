import tempfile
import random
import math
import string
from markupsafe import escape
app = flask.Flask(__name__)

with open("/flag", "r") as file:
    flag = file.read()


def generate_spiral():
    phi = (1 + math.sqrt(5)) / 2
    points = []

    for i in range(3000):
        t = i / 3000 * 8 * math.pi
        r = 450 * phi ** (2 * (t - 8 * math.pi) / math.pi)

        x = 500 + r * math.cos(t)
        y = 500 + r * math.sin(t)

        points.append(f"{x:.2f},{y:.2f}")

    return f"""
        <svg class="spiral" viewBox="0 0 1000 1000">
            <polyline
                points="{' '.join(points)}"
                fill="none"
                stroke="#ffc627"
                stroke-width="5"
            />
        </svg>
    """

spiral = generate_spiral()

def render_page(content):
    return f"""
        <!DOCTYPE html>
        <html>
        <head>
