#!/usr/bin/exec-suid --real -- /usr/bin/python3 -I
import subprocess
import os

subprocess.run(
    ["gcc", "-fno-stack-protector", "-no-pie", "/challenge/spiral_stack.c", "-o", "/challenge/spiral_stack", "-lm"],
    check=True,
)

os.chown("/challenge/spiral_stack", 0, 0)
os.chmod("/challenge/spiral_stack", 0o4756)
