#!/usr/bin/env python

from itertools import product
import random, string, os

DEPTH = 6

with open("/flag", "r") as file:
	real_flag = file.read()

def generate_rand_flag(size):
	size -= 13
	flag = "pwn.college{"
	inside = ''.join(random.choices(string.ascii_letters + string.digits + ".-_", k=size))
	flag += inside + "}"
	return flag

def fib_list(size: int = DEPTH):
    retlist = ["0","1"]
    i = 2
    while i < size:
        retlist.append(str(int(retlist[i-1]) + int(retlist[i-2])))
        i += 1
    return retlist

def generate_filepath(prefix = "maze/", path_list = []):
    path = prefix + "/".join(path_list)
    os.makedirs(path, exist_ok = True)
    return path


fib_list = fib_list()
for i in range(1, len(fib_list) + 1):
    for p in product(fib_list, repeat = i):
        fake_flag = generate_rand_flag(len(real_flag))
        path = generate_filepath(path_list = p)
        with open(f"{path}/flag", "w") as file:
            file.write(fake_flag)

path = generate_filepath(path_list = fib_list)
with open(f"{path}/flag", "w") as file:
    file.write(real_flag)

os.remove(".init")
